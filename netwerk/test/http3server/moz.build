if CONFIG["COMPILE_ENVIRONMENT"]:
    RUST_PROGRAMS += [
        "http3server",
    ]

# Apple's ld-classic cannot emit the LC_RPATH load command used here. The
# legacy macOS build locates bundled libraries through DYLD_LIBRARY_PATH.
if CONFIG["OS_ARCH"] == "Darwin" and not CONFIG["MOZ_LEGACY_MACOS"]:
    LDFLAGS += ["-Wl,-rpath,@executable_path"]

if CONFIG["MOZ_SYSTEM_NSS"]:
    LDFLAGS += CONFIG["NSS_LIBS"]
else:
    USE_LIBS += ["nss"]
